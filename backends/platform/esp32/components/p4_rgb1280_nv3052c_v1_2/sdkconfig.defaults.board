# Board defaults for p4_rgb1280_nv3052c_v1_2 (ScummVM port)
#
# Trimmed from the full sdkconfig of the extended screen firmware to the options that belong to the
# board. Flash size and partitions come from the project's sdkconfig.defaults.

# ESP32-P4 chip revision v1.x on this board
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_0=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y

# PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y

# Console on the USB Serial/JTAG port of the P4 (shows up as a CDC-ACM serial port on the PC)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# RGB driver of components/esp_lcd: bounce buffers filled by the ISR, which must stay in IRAM,
# and the GDMA is restarted every VSYNC.
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y
CONFIG_LCD_RGB_SPLIT_FRAME=y
CONFIG_LCD_RGB_SPLIT_FIFO_OFFSET=0
