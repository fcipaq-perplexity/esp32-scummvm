# ScummVM on the ESP32-P4 tablet boards. Board specific options (chip revision, console, PSRAM mode,
# LCD driver) are in components/<board>/sdkconfig.defaults.board and are applied after this file.
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0xA000
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# ScummVM uses dynamic_cast (IDF 6 puts -fno-rtti into the toolchain flags otherwise)
CONFIG_COMPILER_CXX_RTTI=y
# ScummVM was ported against newlib (picolibc, the IDF 6 default, lacks PATH_MAX etc.)
CONFIG_LIBC_NEWLIB=y
CONFIG_ESP_SYSTEM_GDBSTUB_RUNTIME=y
CONFIG_ESP_PANIC_HANDLER_IRAM=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y

# PSRAM: framebuffers, game data and the 512 KiB ScummVM stack live there
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
# CONFIG_SPIRAM_MEMTEST is not set
# Internal RAM is short: the LCD bounce buffers take ~115 KiB of it (two contiguous 57.6 KiB
# blocks, so the reserve below must not grow). Only small allocations go there.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32767
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

# CONFIG_ESP_TASK_WDT_EN is not set
CONFIG_FREERTOS_HZ=1000

# SD card (FAT, block cache in main/mmc.c)
CONFIG_FATFS_LFN_STACK=y
CONFIG_FATFS_USE_FASTSEEK=y
CONFIG_FATFS_VFS_FSTAT_BLKSIZE=4096

# The RGB panel ISR fills the LCD bounce buffers
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
